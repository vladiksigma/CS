{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch (console)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/bin/Debug/net10.0/CSTEST.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            // 👇 ГЛАВНАЯ СТРОКА, которую нужно изменить:
            "console": "externalTerminal",
            "stopAtEntry": false
        }
    ]
}